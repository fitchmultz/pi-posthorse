{
	"name": "pi-posthorse",
	"version": "0.8.0",
	"type": "module",
	"description": "Posthorse: fresh context, same journey. No-summary context rollover for Pi, with sparse budget reminders, handoffs, notes, and history.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"context",
		"posthorse",
		"rollover"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fitchmultz/pi-posthorse.git"
	},
	"license": "MIT",
	"files": [
		"index.ts",
		"ui.ts",
		"src"
	],
	"engines": {
		"node": ">=24.12.0"
	},
	"packageManager": "npm@12.2.0",
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/fitchmultz/pi-posthorse/main/diagram.png"
	},
	"scripts": {
		"check": "tsc",
		"quality:prepare": "node scripts/setup-oxlint-engine.ts && node scripts/setup-quality-engine.ts",
		"quality:policy": "node scripts/quality-policy.ts",
		"quality:probes": "npm run quality:prepare && node --test test/quality*.test.ts",
		"lint": "npm run quality:prepare && npm run quality:policy && oxlint --deny-warnings .",
		"lint:agent": "npm run quality:prepare && npm run quality:policy && oxlint --deny-warnings --format=agent .",
		"lint:fix": "npm run quality:prepare && npm run quality:policy && oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"build": "npm pack --dry-run",
		"verify": "npm run lint && npm run format:check && npm run check:compat && npm run build",
		"check:compat": "npm run check && npm test && npm run test:native",
		"test:native": "node --import ./test/pi-loader.ts --test test/host.test.mjs",
		"test": "npm run quality:prepare && node --import ./test/pi-loader.ts --test test/*.test.ts",
		"prepublishOnly": "npm run verify"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "24.19.1",
		"oxc-parser": "0.153.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	}
}
