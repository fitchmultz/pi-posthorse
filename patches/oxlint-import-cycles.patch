+#[test]
+fn test_literal_dynamic_and_external_cycles() {
+    use crate::tester::Tester;
+    use serde_json::json;
+
+    let mut pass = vec![
+        (r#"import("./b.ts");"#, Some(json!([{"allowUnsafeDynamicCyclicDependency":true}]))),
+        (r#"import type { T } from "./b.ts";"#, Some(json!([{"ignoreTypes":true}]))),
+        (r#"import { type T } from "./b.ts";"#, Some(json!([{"ignoreTypes":true}]))),
+        (
+            r#"import type { T } from "./b.ts"; import("./b.ts");"#,
+            Some(json!([{"ignoreTypes":true,"allowUnsafeDynamicCyclicDependency":true}])),
+        ),
+        (r#"import "native-cycle";"#, Some(json!([{"ignoreExternal":true}]))),
+        (r#"const path = "./b.ts"; import(path);"#, None),
+        (r#"export const value = 1; export * as ns from "./a.ts";"#, None),
+    ];
+    let mut fail = vec![
+        (r#"import("./b.ts");"#, None),
+        (r#"import("./\u0062.ts");"#, None),
+        (r#"import(`./b.ts`);"#, None),
+        (r#"import("./a.ts");"#, None),
+        (r#"import type { T } from "./b.ts";"#, Some(json!([{"ignoreTypes":false}]))),
+        (
+            r#"import type { T } from "./b.ts"; import("./b.ts");"#,
+            Some(json!([{"ignoreTypes":true}])),
+        ),
+        (
+            r#"import type { T } from "./b.ts"; import("./b.ts");"#,
+            Some(json!([{"ignoreTypes":false,"allowUnsafeDynamicCyclicDependency":true}])),
+        ),
+        (
+            r#"import "./b.ts"; import("./b.ts");"#,
+            Some(json!([{"allowUnsafeDynamicCyclicDependency":true}])),
+        ),
+        (
+            r#"import type { T } from "./b.ts"; import { value } from "./b.ts";"#,
+            Some(json!([{"ignoreTypes":true}])),
+        ),
+        (r#"import "native-cycle";"#, Some(json!([{"ignoreExternal":false}]))),
+        (r#"export const value = 1; export * as ns from "./a.ts"; import("./a.ts");"#, None),
+    ];
+
+    for source in [
+        r#"import(("./b.ts"));"#,
+        r#"import((`./b.ts`));"#,
+        r#"import("./b.ts" as const);"#,
+        r#"import(<string>"./b.ts");"#,
+        r#"import("./b.ts"!);"#,
+        r#"import("./b.ts" satisfies string);"#,
+        r#"import((("./b.ts" as const)! satisfies string));"#,
+    ] {
+        fail.push((source, None));
+        pass.push((source, Some(json!([{"allowUnsafeDynamicCyclicDependency":true}]))));
+    }
+    for source in [
+        r#"const path = "./b.ts"; import((path as string)!);"#,
+        r#"const path = "b"; import((`./${path}.ts` satisfies string));"#,
+    ] {
+        pass.push((source, None));
+        pass.push((source, Some(json!([{"allowUnsafeDynamicCyclicDependency":true}]))));
+    }
+
+    Tester::new(NoCycle::NAME, NoCycle::PLUGIN, pass, fail)
+        .change_rule_path("cycles/native-imports/a.ts")
+        .with_import_plugin(true)
+        .test();
+
+    let pass = vec![
+        (
+            r#"import "./es6/depth-one-dynamic";"#,
+            Some(json!([{"allowUnsafeDynamicCyclicDependency":true}])),
+        ),
+        (r#"import("./es6/depth-two");"#, Some(json!([{"maxDepth":1}]))),
+    ];
+    let fail = vec![
+        (r#"import "./es6/depth-one-dynamic";"#, None),
+        (r#"import("./es6/depth-two");"#, Some(json!([{"maxDepth":2}]))),
+    ];
+    Tester::new(NoCycle::NAME, NoCycle::PLUGIN, pass, fail)
+        .change_rule_path("cycles/depth-zero.js")
+        .with_import_plugin(true)
+        .test();
+}
