+                    literal.quasis.first().and_then(|quasi| quasi.value.cooked.as_deref())
+                }
+                // Runtime-computed specifiers cannot be resolved by the native module graph.
+                _ => None,
+            };
+            if let Some(value) = value {
+                requests.entry(CompactStr::from(value)).or_default().push(RequestedModule {
+                    statement_span: import.span,
+                    span: import.source.span(),
+                    is_type: false,
+                    is_import: true,
+                });
+            }
+        }
+        requests
+    }
