From 43a3313d9143d52c09060ea937ac08e425ccb87a Mon Sep 17 00:00:00 2001
From: Mitch Fultz <57411549+fitchmultz@users.noreply.github.com>
Date: Mon, 5 Oct 2026 18:19:49 -0600
Subject: [PATCH] fix(lib): preserve readonly flatMap callback receiver

---
 internal/bundled/libs/lib.es2019.array.d.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/internal/bundled/libs/lib.es2019.array.d.ts b/internal/bundled/libs/lib.es2019.array.d.ts
index 204f0e69..2d833b76 100644
--- a/internal/bundled/libs/lib.es2019.array.d.ts
+++ b/internal/bundled/libs/lib.es2019.array.d.ts
@@ -32,7 +32,7 @@ interface ReadonlyArray<T> {
      * thisArg is omitted, undefined is used as the this value.
      */
     flatMap<U, This = undefined>(
-        callback: (this: This, value: T, index: number, array: T[]) => U | ReadonlyArray<U>,
+        callback: (this: This, value: T, index: number, array: readonly T[]) => U | ReadonlyArray<U>,
         thisArg?: This,
     ): U[];
 
