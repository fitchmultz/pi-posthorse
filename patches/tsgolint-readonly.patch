+// An allowed handle owns its declared API, not declarations merged into it by a consumer.
+func allowedNativeDeclarations(
+	program *compiler.Program,
+	typeChecker *checker.Checker,
+	t *checker.Type,
+	specifiers []utils.TypeOrValueSpecifier,
+) map[*ast.Node]struct{} {
+	owners := map[*ast.Node]struct{}{}
+	var include func(*ast.Node)
+	include = func(declaration *ast.Node) {
+		if _, present := owners[declaration]; present {
+			return
+		}
+		owners[declaration] = struct{}{}
+		clauses := utils.GetHeritageClauses(declaration)
+		if clauses == nil {
+			return
+		}
+		for _, clause := range clauses.Nodes {
+			if clause.AsHeritageClause().Token != ast.KindExtendsKeyword {
+				continue
+			}
+			for _, reference := range clause.AsHeritageClause().Types.Nodes {
+				base := typeChecker.GetTypeAtLocation(reference)
+				symbol := checker.Type_symbol(base)
+				if symbol == nil {
+					continue
+				}
+				for _, baseDeclaration := range symbol.Declarations {
+					if nativeBaseDeclaration(program, symbol, baseDeclaration) {
+						include(baseDeclaration)
+					}
+				}
+			}
+		}
+	}
+	symbols := []*ast.Symbol{checker.Type_symbol(t)}
+	if alias := checker.Type_alias(t); alias != nil {
+		symbols = append(symbols, alias.Symbol())
+	}
+	for _, symbol := range symbols {
+		if symbol == nil {
+			continue
+		}
+		for _, declaration := range symbol.Declarations {
+			if utils.Some(specifiers, func(specifier utils.TypeOrValueSpecifier) bool {
+				return utils.DeclarationMatchesSpecifierSource(declaration, specifier, program)
+			}) {
+				include(declaration)
+			}
+		}
+	}
+	return owners
+}
+
+func nativeBaseDeclaration(program *compiler.Program, symbol *ast.Symbol, declaration *ast.Node) bool {
+	file := ast.GetSourceFileOfNode(declaration)
+	if utils.IsSourceFileDefaultLibrary(program, file) {
+		return true
+	}
+	original := symbol.ValueDeclaration
+	if original == nil && symbol.Parent != nil {
+		original = symbol.Parent.ValueDeclaration
+	}
+	if original == nil {
+		return false
+	}
+	originalFile := ast.GetSourceFileOfNode(original)
+	if originalFile == nil {
+		return false
+	}
+	// Class/interface inheritance spelled in the approved declaration includes
+	// its native base API, but not foreign declarations augmenting that base.
+	return utils.DeclarationMatchesSpecifierSource(declaration, utils.TypeOrValueSpecifier{
+		From: utils.TypeOrValueSpecifierFromFile, Path: originalFile.FileName(),
+	}, program)
+}
+
+func declarationOwnedBy(declaration *ast.Node, owners map[*ast.Node]struct{}) bool {
+	for node := declaration; node != nil; node = node.Parent {
+		if _, owned := owners[node]; owned {
+			return true
+		}
+	}
+	return false
+}
