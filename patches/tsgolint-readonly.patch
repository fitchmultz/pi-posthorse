+func nativeCollectionOwner(program *compiler.Program, property *ast.Symbol) string {
+	owner := ""
+	for _, declaration := range property.Declarations {
+		parent := declaration.Parent
+		if parent == nil || parent.Kind != ast.KindInterfaceDeclaration ||
+			!utils.IsSourceFileDefaultLibrary(program, ast.GetSourceFileOfNode(declaration)) {
+			return ""
+		}
+		name := parent.Name()
+		if name == nil {
+			return ""
+		}
+		switch name.Text() {
+		case "Map", "Set", "ReadonlyMap", "ReadonlySet", "ReadonlyArray":
+			if owner != "" && owner != name.Text() {
+				return ""
+			}
+			owner = name.Text()
+		default:
+			return ""
+		}
+	}
+	return owner
+}
