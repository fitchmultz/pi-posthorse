+// Library collection APIs have explicit mutation contracts. Do not grant the
+// same contract to a same-named application interface or an added property.
+func nativeCollectionOwner(program *compiler.Program, property *ast.Symbol) string {
+	owner := ""
+	for _, declaration := range property.Declarations {
+		parent := declaration.Parent
+		if parent == nil || parent.Kind != ast.KindInterfaceDeclaration ||
+			!utils.IsSourceFileDefaultLibrary(program, ast.GetSourceFileOfNode(declaration)) {
+			return ""
+		}
+		name := parent.Name()
+		if name == nil {
+			return ""
+		}
+		switch name.Text() {
+		case "Map", "Set", "ReadonlyMap", "ReadonlySet":
+			if owner != "" && owner != name.Text() {
+				return ""
+			}
+			owner = name.Text()
+		default:
+			return ""
+		}
+	}
+	return owner
+}
+
+func readonlyCollectionContents(
+	program *compiler.Program,
+	typeChecker *checker.Checker,
+	t *checker.Type,
+	opts readonlynessOptions,
+	seenTypes map[*checker.Type]struct{},
+) readonlyness {
+	// `has` exposes map keys / set values; `get` exposes map values. Inspect
+	// instantiated signatures so mapped views retain the actual generic data.
+	for _, name := range []string{"has", "get"} {
+		propertyType := checker.Checker_getTypeOfPropertyOfType(typeChecker, t, name)
+		if propertyType == nil {
+			continue
+		}
+		for _, signature := range utils.GetCallSignatures(typeChecker, propertyType) {
+			for _, parameter := range checker.Signature_parameters(signature) {
+				parameterType := checker.Checker_getTypeOfSymbol(typeChecker, parameter)
+				if isTypeReadonlyRecurser(program, typeChecker, parameterType, opts, seenTypes) != readonlynessReadonly {
+					return readonlynessMutable
+				}
+			}
+			if name == "get" {
+				result := typeChecker.GetReturnTypeOfSignature(signature)
+				if isTypeReadonlyRecurser(program, typeChecker, result, opts, seenTypes) != readonlynessReadonly {
+					return readonlynessMutable
+				}
+			}
+		}
+	}
+	return readonlynessReadonly
+}
