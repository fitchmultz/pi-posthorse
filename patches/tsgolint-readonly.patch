+func allowedNativeTypeIsReadonly(
+	program *compiler.Program,
+	typeChecker *checker.Checker,
+	t *checker.Type,
+	opts readonlynessOptions,
+	seenTypes map[*checker.Type]struct{},
+) readonlyness {
+	matched := utils.Filter(opts.allow, func(specifier utils.TypeOrValueSpecifier) bool {
+		return utils.TypeMatchesSomeSpecifier(t, []utils.TypeOrValueSpecifier{specifier}, program)
+	})
+	if utils.Some(matched, func(specifier utils.TypeOrValueSpecifier) bool {
+		return specifier.From == utils.TypeOrValueSpecifierFromName
+	}) {
+		return readonlynessReadonly
+	}
+	owners := allowedNativeDeclarations(program, typeChecker, t, matched)
+	for _, property := range checker.Checker_getPropertiesOfType(typeChecker, t) {
+		if len(property.Declarations) > 0 && utils.Every(property.Declarations, func(declaration *ast.Node) bool {
+			return declarationOwnedBy(declaration, owners)
+		}) {
+			continue
+		}
+		if !propertyIsReadonly(typeChecker, property) &&
+			!(opts.treatMethodsAsReadonly && property.Flags&ast.SymbolFlagsMethod != 0) &&
+			!propertyHasPrivateIdentifierName(property) && !propertyIsPrivateMappedProperty(property) {
+			return readonlynessMutable
+		}
+		propertyType := checker.Checker_getTypeOfPropertyOfType(typeChecker, t, property.Name)
+		if propertyType != nil {
+			if _, seen := seenTypes[propertyType]; !seen &&
+				isTypeReadonlyRecurser(program, typeChecker, propertyType, opts, seenTypes) == readonlynessMutable {
+				return readonlynessMutable
+			}
+		}
+	}
+	for _, info := range checker.Checker_getIndexInfosOfType(typeChecker, t) {
+		if declaration := info.Declaration(); declaration != nil && declarationOwnedBy(declaration, owners) {
+			continue
+		}
+		if !info.IsReadonly() {
+			return readonlynessMutable
+		}
+		if value := info.ValueType(); value != nil {
+			if _, seen := seenTypes[value]; !seen &&
+				isTypeReadonlyRecurser(program, typeChecker, value, opts, seenTypes) == readonlynessMutable {
+				return readonlynessMutable
+			}
+		}
+	}
+	return readonlynessReadonly
+}
