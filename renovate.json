{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>fitchmultz/.github:pi-extensions"],
	"packageRules": [
		{
			"description": "Update development TypeBox with the host cohort, not independently; see README Develop.",
			"matchManagers": ["npm"],
			"matchDepTypes": ["devDependencies"],
			"matchPackageNames": ["typebox"],
			"enabled": false
		},
		{
			"description": "Qualify Pi updates at the supported 1.0 floor or later.",
			"matchManagers": ["npm"],
			"matchDepTypes": ["devDependencies"],
			"matchPackageNames": ["@earendil-works/**"],
			"allowedVersions": ">=1.0.0"
		}
	]
}
