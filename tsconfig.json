{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"types": ["node"],
		"strict": true,
		"noImplicitReturns": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"index.ts",
		"ui.ts",
		"src/**/*.ts",
		"test/**/*.ts",
		"test/**/*.mjs",
		"scripts/**/*.ts"
	]
}
