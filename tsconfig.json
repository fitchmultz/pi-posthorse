{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["index.ts", "ui.ts", "test/*.ts"]
}
